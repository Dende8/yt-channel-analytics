# Este archivo solo es necesario para volver a descargar los datos con yt_analyst.
# La aplicación y los cuadernos funcionan sin él, con los CSV de data/csv.
# Para usarlo: copiar a .env y rellenar las credenciales.

# Credenciales OAuth: solo hacen falta para descargar datos de la API
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Carpeta de salida de la extracción
OUTPUT_DIR=data/extraction

# Opcionales
# Fecha de inicio de los informes (AAAA-MM-DD); si se deja vacía, se usa la creación del canal
ANALYTICS_START_DATE=
# Días que se restan a hoy como fecha final, porque Analytics tarda en consolidar los datos
END_DATE_LAG_DAYS=3
REQUEST_PAUSE_SECONDS=0.3
# Moneda de los ingresos; si se deja vacía, se usa la del canal
REVENUE_CURRENCY=