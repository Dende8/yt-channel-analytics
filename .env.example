YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Opcionales
OUTPUT_DIR=data
# Los datos de Analytics llegan con retraso: el rango termina N días atrás
END_DATE_LAG_DAYS=3
# Pausa entre llamadas a Analytics (segundos)
REQUEST_PAUSE_SECONDS=0.3
# Fuerza una fecha de inicio (YYYY-MM-DD). Vacío = fecha de creación del canal
ANALYTICS_START_DATE=
# Moneda ISO 4217 para ingresos (ej. EUR). Vacío = valor por defecto de la API
REVENUE_CURRENCY=